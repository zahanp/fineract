#
# FAILURE SIMULATION — Scenario 1: Null Datasource (HikariCP pool init failure)
#
# Green is started pointing at a non-existent DB host.
# HikariCP throws CannotGetJdbcConnectionException on the first request.
# The health check (nc -z :8443) passes because the port opens before the pool
# is tested, so nginx cuts over — and then every request returns HTTP 500.
#
# To trigger: use this env file instead of fineract-postgresql.env for fineract-green.
# To recover: rollback nginx to blue (nginx -s reload), then fix the JDBC URL.
#
FINERACT_HIKARI_DRIVER_SOURCE_CLASS_NAME=org.postgresql.Driver
FINERACT_HIKARI_JDBC_URL=jdbc:postgresql://db-does-not-exist:5432/fineract_tenants
FINERACT_HIKARI_USERNAME=postgres
FINERACT_HIKARI_PASSWORD=skdcnwauicn2ucnaecasdsajdnizucawencascdca
FINERACT_DEFAULT_TENANTDB_PORT=5432
FINERACT_DEFAULT_TENANTDB_UID=postgres